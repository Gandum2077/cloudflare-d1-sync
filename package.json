{
  "name": "cloudflare-d1-sync",
  "version": "1.0.0",
  "description": "Single-user, offline-first structured data sync on Cloudflare Workers and D1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run types:check && npm run typecheck && npm run lint && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "dev": "wrangler dev --local",
    "lint": "eslint src test vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars false",
    "types:check": "wrangler types --env-file .dev.vars.example --strict-vars false --check"
  },
  "keywords": [
    "cloudflare-workers",
    "d1",
    "offline-first",
    "sync"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database that stores synchronized data and change history."
      },
      "MASTER_KEY": {
        "description": "Generate a 64-character lowercase hex key with 256 bits of entropy. The project guide can generate one locally in your browser."
      }
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
